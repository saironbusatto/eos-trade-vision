# EOS Telegram Bot - Production Profile
# Copy to .env on server/container and fill real secrets.

NODE_ENV=production
PORT=3000

# API auth for internal endpoints (/api/signal, /api/alert)
API_SECRET=replace_with_strong_random_secret

# Telegram
TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=replace_with_botfather_token
TELEGRAM_CHANNEL_ID=@your_channel_or_-100xxxxxxxxxx

# Sentiment pipeline
ENABLE_SENTIMENT_ANALYSIS=false
OPENAI_API_KEY=replace_if_enable_sentiment
AUTO_TRADER_MIN_SIGNAL_AGE_MIN=0
PYTHON_BIN=python3
ML_INFER_SCRIPT=/app/ml/infer.py

# External services
ML_API_URL=http://localhost:5000
PERPLEXITY_API_KEY=replace_if_used

# Database
DATABASE_PATH=./data/eos.db

# Stats phase tag (backend segmentation of wins/losses counters)
STATS_PHASE_TAG="fase jim compound v1"

# Data Engine tuning (stability-first defaults)
ENGINE_TARGET_COVERAGE_SEC=3300
ENGINE_MAX_LAG_MS=8000
ENGINE_RECOVERY_LAG_MS=3000
ENGINE_LAG_BREACHES_TO_DEGRADE=3
ENGINE_HEALTHY_CHECKS_TO_RECOVER=2
