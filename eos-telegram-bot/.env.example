# EOS Telegram Bot - Environment Variables
# Copy this file to .env and fill in your values

# Enable/disable Telegram listener (true/false)
TELEGRAM_ENABLED=true

# Telegram Bot Token (from @BotFather)
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Channel ID (e.g., @eos_signals or -1001234567890)
TELEGRAM_CHANNEL_ID=@your_channel_username

# API Secret Key (generate a random string)
API_SECRET=your_secret_key_here

# Sentiment / AutoTrader behavior
ENABLE_SENTIMENT_ANALYSIS=false
OPENAI_API_KEY=
AUTO_TRADER_MIN_SIGNAL_AGE_MIN=0
PYTHON_BIN=python3
ML_INFER_SCRIPT=/app/ml/infer.py
ML_MODEL_DIR=/app/data/ml/models
ML_INFERENCE_TIMEOUT_MS=2500
ML_FAIL_OPEN_ON_ERROR=false
ML_RECALIBRATION_ENABLED=true
ML_RECALIBRATION_INTERVAL_HOURS=168
ML_RECALIBRATION_CHECK_INTERVAL_MIN=15
ML_RECALIBRATION_MIN_ML_RECORDS=400
ML_RECALIBRATION_MIN_GATE_F1=0.45
ML_RECALIBRATION_MIN_DIRECTION_F1=0.30
ML_RECALIBRATION_MAX_F1_DROP=0.03
ML_RECALIBRATION_SCRIPT_TIMEOUT_MS=2700000
ML_PIPELINE_DIR=/app/ml
# Set true once to force retraining on next boot, then revert to false
ML_RECALIBRATION_FORCE_NOW=false

# ML training dataset options
ML_GATE_LABEL_MODE=win
ML_LABEL_THRESHOLD_PCT=0.5

# Port (Railway will set this automatically)
PORT=3000

# Strategy tracking
ACTIVE_STRATEGY_VERSION=v3.0
# Logical phase tag for backend stats segmentation.
# Change this tag to start a new phase without deleting historical DB data.
STATS_PHASE_TAG="fase jim compound v1"
# Optional one-shot fixed baseline (ISO-8601, UTC). Prefer STATS_PHASE_TAG for normal usage.
STATS_BASELINE_AT=

# Data Engine tuning
ENGINE_TARGET_COVERAGE_SEC=3300
ENGINE_MAX_LAG_MS=8000
ENGINE_RECOVERY_LAG_MS=3000
ENGINE_LAG_BREACHES_TO_DEGRADE=3
ENGINE_HEALTHY_CHECKS_TO_RECOVER=2

# Conservative compounding risk profile (short targets, realistic exits)
RISK_STOP_MIN_PERCENT=0.45
RISK_STOP_MAX_PERCENT=0.95
RISK_TARGET_MIN_PERCENT=0.35
RISK_TARGET_MAX_PERCENT=0.90
RISK_TARGET_STOP_RATIO=0.80
RISK_VOL_TO_STOP_MULTIPLIER=0.70

# Hour x Direction performance filter
ENABLE_HOUR_DIRECTION_FILTER=true
HOUR_DIRECTION_MIN_TRADES=80
HOUR_DIRECTION_MIN_WINRATE=52
HOUR_DIRECTION_MIN_WINRATE_CI95_LOW=45
ENABLE_EXPECTANCY_GATE=true
HOUR_DIRECTION_MIN_EXPECTANCY_CI95_LOW=0

# Unified decision score (hour+direction+regime+sentiment+ML)
ENABLE_UNIFIED_DECISION_SCORE=true
UNIFIED_DECISION_MIN_SCORE=0.62
UNIFIED_SCORE_WEIGHT_OFA=0.30
UNIFIED_SCORE_WEIGHT_ML=0.30
UNIFIED_SCORE_WEIGHT_EDGE=0.20
UNIFIED_SCORE_WEIGHT_REGIME=0.10
UNIFIED_SCORE_WEIGHT_SENTIMENT=0.10
UNIFIED_SCORE_SENTIMENT_WINDOW_MIN=180
UNIFIED_SCORE_SENTIMENT_MIN_IMPACT=4
UNIFIED_SCORE_REQUIRE_ML_APPROVAL=true
